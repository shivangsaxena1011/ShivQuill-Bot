# ==========================================================
# ShivQuill AI Writing Platform - Environment Configuration
# ==========================================================

# Server Environment (development | production | test)
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Provider Selection: GROQ, OPENAI, OPENROUTER, or CUSTOM
# Auto-detects based on available API key if left commented out.
# NOTE: REQUEST_TYPE=MOCK is reserved strictly for local unit test simulations.
REQUEST_TYPE=GROQ

# Sentence segmentation chunk size (number of sentences per LLM request, min 1)
SENTENCES_IN_PROMPT=3

# ----------------------------------------------------------
# Provider 1: Groq (Recommended - High throughput Llama 3.3)
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ----------------------------------------------------------
# Provider 2: OpenAI (GPT-4o, GPT-4o-mini)
# ----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Provider 3: OpenRouter (Multi-model aggregation)
# ----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ----------------------------------------------------------
# Provider 4: Custom Local or Self-Hosted Endpoint (Ollama, vLLM, etc.)
# ----------------------------------------------------------
CUSTOM_API_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_API_MODEL=llama3

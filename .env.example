# ==========================================================
# ShivQuill AI Writing Platform - Environment Configuration
# Easiest: run `npm run setup:keys` to fill in keys interactively (see docs/api-keys.md).
# ==========================================================

# Server Environment (development | production | test)
PORT=5000
NODE_ENV=development
# Extra allowed browser origins, comma-separated. The server's own host is always allowed,
# so on Render you do NOT need to set this when using the built-in frontend.
CORS_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (1 on Render/Heroku-style hosts)
TRUST_PROXY=1

# Max AI-backed requests per client IP per minute
AI_REQUESTS_PER_MINUTE=30

# Corpus Administration Secret Key (Required for POST /api/originality/corpus mutations)
CORPUS_ADMIN_KEY=change-this-to-a-secure-random-token

# Provider Selection: GROQ, OPENAI, OPENROUTER, or CUSTOM
# Auto-detects based on available API key if left commented out.
# NOTE: REQUEST_TYPE=MOCK is reserved strictly for local unit test simulations.
REQUEST_TYPE=GROQ

# Sentence segmentation chunk size (number of sentences per LLM request, min 1)
SENTENCES_IN_PROMPT=3

# Max characters per single provider request (larger inputs are split into batches)
MAX_CHARS_PER_REQUEST=12000

# Comma-separated model IDs that clients may request via the `model` field.
# The active provider's default model is always allowed. Leave empty to lock to the default.
ALLOWED_MODELS=

# ----------------------------------------------------------
# Provider 1: Groq (High throughput Llama 3)
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# llama-3.3-70b-versatile and llama-3.1-8b-instant were retired by Groq on 2026-08-16. Alternative:
# GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------
# Provider 2: OpenAI (GPT-4o, GPT-4o-mini)
# ----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Provider 3: OpenRouter (Multi-model aggregation)
# ----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ----------------------------------------------------------
# Provider 4: Custom Local or Self-Hosted Endpoint (Ollama, vLLM, etc.)
# ----------------------------------------------------------
CUSTOM_API_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_API_MODEL=llama3

# ----------------------------------------------------------
# Plagiarism checker (works free with no keys)
# ----------------------------------------------------------
# Key-free sources used by default: Wikipedia API, DuckDuckGo web results (best effort),
# Crossref, OpenAlex and arXiv, plus the local reference library.
# Set to false to only check the local library (no outbound searches).
PLAGIARISM_ONLINE=true
# Web engine: auto | duckduckgo | google | brave | searxng | off
# "auto" uses a keyed engine below if configured, otherwise DuckDuckGo.
PLAGIARISM_WEB_SEARCH=auto
# Optional free tiers for more reliable full-web coverage (shared/free DuckDuckGo access can be throttled):
# Google Programmable Search (100 free queries/day): https://programmablesearchengine.google.com
GOOGLE_CSE_KEY=
GOOGLE_CSE_ID=
# Brave Search API free plan: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=
# Your own SearXNG instance (open source, free): e.g. https://searx.example.org
SEARXNG_URL=
# Free OpenAlex API key avoids anonymous rate limits: https://openalex.org/rest-api
OPENALEX_API_KEY=
# Optional contact info sent in the User-Agent to Wikipedia/Crossref/arXiv (their etiquette asks for one)
PLAGIARISM_CONTACT=
CROSSREF_MAILTO=
# Tuning (defaults shown)
PLAGIARISM_MAX_QUERIES=8
PLAGIARISM_MAX_PAGES=14
# Seconds to skip a search engine that timed out / is unreachable from this server (e.g. DuckDuckGo from cloud IPs)
PLAGIARISM_UNREACHABLE_PAUSE_SEC=300

# AI detector: maximum words analyzed per scan
AI_DETECTOR_MAX_WORDS=6000

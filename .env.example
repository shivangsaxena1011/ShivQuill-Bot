# Server Configuration
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# Provider Selection: MOCK (offline/tests), GROQ, OPENROUTER, OPENAI, or CUSTOM
REQUEST_TYPE=MOCK

# Sentence segmentation chunk size (Defaults to 3, minimum 1)
SENTENCES_IN_PROMPT=3

# Groq Configuration (Ultra-fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# OpenRouter Configuration
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# Custom OpenAI-Compatible Endpoint (vLLM, Ollama, LocalAI, etc.)
CUSTOM_API_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_API_MODEL=llama3

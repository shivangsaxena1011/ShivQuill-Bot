# ==========================================================
# ShivQuill AI Writing Platform - Environment Configuration
# ==========================================================

# Server Environment (development | production | test)
PORT=5000
NODE_ENV=development
# Extra allowed browser origins, comma-separated. The server's own host is always allowed,
# so on Render you do NOT need to set this when using the built-in frontend.
CORS_ORIGIN=http://localhost:5173

# Number of reverse-proxy hops to trust for client IPs (1 on Render/Heroku-style hosts)
TRUST_PROXY=1

# Max AI-backed requests per client IP per minute
AI_REQUESTS_PER_MINUTE=30

# Corpus Administration Secret Key (Required for POST /api/originality/corpus mutations)
CORPUS_ADMIN_KEY=change-this-to-a-secure-random-token

# Provider Selection: GROQ, OPENAI, OPENROUTER, or CUSTOM
# Auto-detects based on available API key if left commented out.
# NOTE: REQUEST_TYPE=MOCK is reserved strictly for local unit test simulations.
REQUEST_TYPE=GROQ

# Sentence segmentation chunk size (number of sentences per LLM request, min 1)
SENTENCES_IN_PROMPT=3

# Max characters per single provider request (larger inputs are split into batches)
MAX_CHARS_PER_REQUEST=12000

# Comma-separated model IDs that clients may request via the `model` field.
# The active provider's default model is always allowed. Leave empty to lock to the default.
ALLOWED_MODELS=

# ----------------------------------------------------------
# Provider 1: Groq (High throughput Llama 3)
# ----------------------------------------------------------
GROQ_API_KEY=gsk_your_groq_api_key_here
# llama-3.3-70b-versatile and llama-3.1-8b-instant were retired by Groq on 2026-08-16. Alternative:
# GROQ_MODEL=qwen/qwen3.6-27b
GROQ_MODEL=openai/gpt-oss-120b

# ----------------------------------------------------------
# Provider 2: OpenAI (GPT-4o, GPT-4o-mini)
# ----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# Provider 3: OpenRouter (Multi-model aggregation)
# ----------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct

# ----------------------------------------------------------
# Provider 4: Custom Local or Self-Hosted Endpoint (Ollama, vLLM, etc.)
# ----------------------------------------------------------
CUSTOM_API_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_API_MODEL=llama3
